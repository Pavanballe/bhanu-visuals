import React,{useEffect,useMemo,useState} from 'react'
import {createRoot} from 'react-dom/client'
import {AnimatePresence,motion} from 'framer-motion'
import {ArrowRight,Camera,Check,Clapperboard,Film,Instagram,Mail,MapPin,Menu,MessageCircle,Plus,Receipt,Search,Send,Settings,ShieldCheck,Sparkles,Trash2,Users,Video,X,CalendarDays,WalletCards,Download,Edit3,LogOut,LayoutDashboard} from 'lucide-react'
import './styles.css'

const WHATSAPP='9346169352',EMAIL='bhanuvisuals17@gmail.com'
const serviceGroups=[
{icon:Video,title:'Videography',items:['Cinematic Videography','Professional Event Videography','Wedding Videography','Pre-Wedding Cinematic Films','Engagement & Reception Coverage','Birthday & Party Videos','Festival & Religious Event Videos','Political & Public Event Coverage','Corporate & Business Videography','Promotional Videos','Brand Videos','Music Videos','Short Films','Documentary-Style Videos','Cinematic Highlight Films','Event Teaser Videos','After-Movie Videos']},
{icon:Camera,title:'Photography',items:['Professional Photography','Candid Photography','Wedding Photography','Pre-Wedding Photography','Couple Photography','Portrait Photography','Event Photography','Birthday Photography','Festival Photography','Product Photography','Fashion Photography','Corporate Photography','Group & Family Photography','Traditional Photography']},
{icon:Camera,title:'Aerial & Advanced Production',items:['Drone Videography','Drone Photography','Aerial Cinematic Shots','FPV Drone Shots','Gimbal Cinematography','Professional Cinema Camera Shoots','Multi-Camera Event Coverage','Slow-Motion Cinematic Shots','Tracking & Motion Shots']},
{icon:Instagram,title:'Social Media Content',items:['Instagram Reels','Cinematic Reels','Event Reels','Wedding Reels','Promotional Reels','YouTube Videos','YouTube Shorts','Social Media Content Creation','Business Promotional Content','Instagram Highlight Videos']},
{icon:Film,title:'Editing & Post-Production',items:['Professional Video Editing','Cinematic Color Grading','Color Correction','Sound Design','Music Synchronization','Motion Graphics','Title & Text Animation','Transitions & Visual Effects','Slow Motion Editing','Highlight Video Editing','Reel Editing','Trailer & Teaser Editing','Photo Retouching','Photo Color Correction']},
{icon:Sparkles,title:'Special Event Coverage',items:['Ganesh Chaturthi Events','Sri Ram Sena Events','Processions & Aagman','Nimajjanam / Visarjan Coverage','Temple Events','Cultural Programs','College Events','Community Events','Stage Programs','Public Gatherings','Inauguration Events']}]
const customOptions=['Cinema Camera','Drone','Gimbal','Candid Photography','Professional Videography','Cinematic Reel','Highlight Film','Professional Editing','Color Grading','Extra Reel']
const initialProjects=[
{id:'demo-1',title:'Sri Ram Sena â€” Aagman',category:'Special Events',description:'A high-energy cinematic event story built around movement, crowd moments and hero visuals.',image:'https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=1400&q=85',video:'',featured:true},
{id:'demo-2',title:'Golden Hour â€” Couple Story',category:'Pre-Wedding',description:'A warm, intimate visual story with cinematic portraits and movement-driven frames.',image:'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=85',video:'',featured:true},
{id:'demo-3',title:'Brand Motion â€” Product Film',category:'Brand & Commercial',description:'A premium product-focused reel concept designed for social media conversion.',image:'https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=1400&q=85',video:'',featured:false}]
function Logo(){return <a className="logo" href="/" aria-label="Bhanu Visuals home"><span className="logo-mark">BV</span><span><b>BHANU VISUALS</b><small>SHOOT â€¢ EDIT â€¢ ELEVATE</small></span></a>}
function App(){const[projects,setProjects]=useState(initialProjects),[menu,setMenu]=useState(false),[activeService,setActiveService]=useState(null),[activeProject,setActiveProject]=useState(null),[custom,setCustom]=useState([]),[form,setForm]=useState({name:'',email:'',phone:'',type:'Wedding',details:''}),[status,setStatus]=useState('');useEffect(()=>{fetch('/api/projects').then(r=>r.ok?r.json():null).then(d=>{if(Array.isArray(d)&&d.length)setProjects(d)}).catch(()=>{})},[]);const complete=form.name.trim()&&/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)&&form.phone.trim()&&form.details.trim();const submit=async e=>{e.preventDefault();if(!complete||!custom.length){setStatus('Complete your details and select at least one custom service.');return}setStatus('Sending enquiry and PDF...');try{const r=await fetch('/api/enquiries',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...form,mode:'custom',package:'Custom Package',packagePrice:'Quotation after review',customServices:custom})}),d=await r.json();if(!r.ok)throw Error(d.error||'Could not submit enquiry');setStatus(`Transmission received. Customer ID: ${d.customerId} â€¢ Booking ID: ${d.bookingId}. Your enquiry is saved in the CRM.`);setForm({name:'',email:'',phone:'',type:'Wedding',details:''});setCustom([])}catch(e){setStatus(e.message)}};return <div className="app"><header className="nav"><Logo/><button className="menu-btn" onClick={()=>setMenu(!menu)}><Menu/></button><nav className={menu?'open':''}>{['home','services','projects','contact'].map(x=><a key={x} href={'#'+x} onClick={()=>setMenu(false)}>{x}</a>)}</nav></header><main><section id="home" className="hero section-pad"><div className="hero-minimal"><div className="hero-mark">BV</div><div className="hero-brand">BHANU VISUALS</div><div className="hero-caption">Photography â€¢ Videography â€¢ Cinematic Stories</div></div></section><section id="services" className="section-pad services-section"><div className="section-head"><div><div className="eyebrow">WHAT WE DO</div><h2>Services <em>that tell stories.</em></h2></div><p>Professional photography, videography, aerial production, social content and post-production.</p></div><div className="service-grid">{serviceGroups.map((g,i)=>{const I=g.icon;return <button className={`service-card ${activeService===i?'active':''}`} key={g.title} onClick={()=>setActiveService(activeService===i?null:i)}><div className="service-icon"><I size={20}/></div><span className="service-num">0{i+1}</span><h3>{g.title}</h3><p>{g.items.length} services</p>{activeService===i&&<div className="service-list">{g.items.map(x=><span key={x}><Check size={12}/>{x}</span>)}</div>}</button>})}</div></section><section id="projects" className="section-pad projects-section"><div className="section-head"><div><div className="eyebrow">SELECTED WORK</div><h2>Projects <em>by BV.</em></h2></div><p>Portfolio controlled directly from the private Admin Panel.</p></div><div className="project-grid">{projects.map((p,i)=><button key={p.id} className={`project-card ${i===0?'large':''}`} onClick={()=>setActiveProject(p)}><img src={p.image} alt={p.title}/><div className="project-overlay"><div><span>{p.category}</span><h3>{p.title}</h3></div><span className="circle-arrow"><ArrowRight size={16}/></span></div></button>)}</div></section><section id="contact" className="section-pad contact-section"><div className="contact-shell"><div className="contact-intro"><div className="eyebrow">LET'S CREATE</div><h2>Tell us about<br/><em>your project.</em></h2><p>Complete your details, choose your custom services and send your enquiry. A unique Booking ID and PDF are created automatically.</p><div className="contact-lines"><a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noreferrer"><MessageCircle size={18}/> {WHATSAPP}</a><a href={`mailto:${EMAIL}`}><Mail size={18}/> {EMAIL}</a><span><MapPin size={18}/> Local & outstation shoots</span></div></div><form className="contact-form" onSubmit={submit}><div className="form-title"><span>PROJECT ENQUIRY</span><ShieldCheck size={17}/></div><div className="form-grid"><label>Client name<input required value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/></label><label>Email<input required type="email" value={form.email} onChange={e=>setForm({...form,email:e.target.value})}/></label><label>Phone<input required value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})}/></label><label>Project type<select value={form.type} onChange={e=>setForm({...form,type:e.target.value})}>{['Wedding','Pre-Wedding','Birthday','Festival / Religious','Corporate','Brand Promotion','Political / Public Event','Music Video','Reel / Social Media','Other'].map(x=><option key={x}>{x}</option>)}</select></label></div><label>Project details<textarea required rows="5" value={form.details} onChange={e=>setForm({...form,details:e.target.value})} placeholder="Date, location, event size, creative direction..."/></label>{!complete?<div className="locked-box"><ShieldCheck size={18}/><div><b>Custom package selection locked</b><span>Complete name, email, phone and project details to continue.</span></div></div>:<div className="custom-builder"><div className="builder-title"><span>CUSTOMIZE YOUR PACKAGE</span><small>Select at least one service</small></div><div className="custom-options">{customOptions.map(x=><label key={x}><input type="checkbox" checked={custom.includes(x)} onChange={e=>setCustom(e.target.checked?[...custom,x]:custom.filter(v=>v!==x))}/><span>{x}</span></label>)}</div></div>}<button className="gold-btn submit" disabled={!complete||!custom.length}><Send size={16}/> Send Transmission</button>{status&&<div className="status"><Check size={15}/>{status}</div>}</form></div></section></main><footer><Logo/><span>Â(c) {new Date().getFullYear()} Bhanu Visuals. All visual rights reserved.</span><a href="https://instagram.com/bhanuvisuals17" target="_blank" rel="noreferrer"><Instagram size={17}/></a></footer><AnimatePresence>{activeProject&&<motion.div className="modal-backdrop" initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0}} onClick={()=>setActiveProject(null)}><motion.div className="project-modal" initial={{y:30}} animate={{y:0}} exit={{y:30}} onClick={e=>e.stopPropagation()}><button className="modal-close" onClick={()=>setActiveProject(null)}><X/></button><img src={activeProject.image} alt={activeProject.title}/><div className="modal-copy"><span>{activeProject.category}</span><h2>{activeProject.title}</h2><p>{activeProject.description}</p><a className="gold-btn" href="#contact" onClick={()=>setActiveProject(null)}>Enquire <ArrowRight size={16}/></a></div></motion.div></motion.div>}</AnimatePresence></div>}

const api=(path,token,options={})=>fetch(path,{...options,headers:{'Content-Type':'application/json',Authorization:`Bearer ${token}`,...(options.headers||{})}})
function Admin(){const[token,setToken]=useState(localStorage.getItem('bv_admin_token')||''),[login,setLogin]=useState({username:'',password:''}),[tab,setTab]=useState('dashboard'),[data,setData]=useState({projects:[],enquiries:[],customers:[],shoots:[],invoices:[],settings:{}}),[selectedCustomer,setSelectedCustomer]=useState(null),[selectedBooking,setSelectedBooking]=useState(null),[search,setSearch]=useState(''),[msg,setMsg]=useState(''),[projectForm,setProjectForm]=useState({title:'',category:'',description:'',image:'',video:'',featured:false}),[editingProject,setEditingProject]=useState(null),[invoiceForm,setInvoiceForm]=useState({customerId:'',bookingId:'',type:'Advance',items:[{name:'Advance / Booking',amount:''}],total:'',amountDue:'',paid:'0',notes:''}),[shootForm,setShootForm]=useState({customerId:'',bookingId:'',shootDate:'',location:'',type:'Wedding',status:'Upcoming',services:'',notes:''}),[settingsForm,setSettingsForm]=useState({businessName:'BHANU VISUALS',phone:WHATSAPP,email:EMAIL,upiId:'',upiName:'Bhanu Visuals'});const headers=()=>({Authorization:`Bearer ${token}`});const load=async()=>{const H=headers();const get=p=>fetch(p,{headers:H}).then(r=>r.ok?r.json():[]);const [projects,enquiries,customers,shoots,invoices,settings]=await Promise.all([get('/api/projects'),get('/api/admin/enquiries'),get('/api/admin/customers'),get('/api/admin/shoots'),get('/api/admin/invoices'),get('/api/admin/settings')]);setData({projects,enquiries,customers,shoots,invoices,settings});setSettingsForm(settings)};useEffect(()=>{if(token)load().catch(()=>setToken(''))},[token]);const doLogin=async e=>{e.preventDefault();const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(login)}),d=await r.json();if(r.ok){localStorage.setItem('bv_admin_token',d.token);setToken(d.token)}else setMsg(d.error||'Login failed')};const saveProject=async e=>{e.preventDefault();const url=editingProject?`/api/admin/projects/${editingProject}`:'/api/admin/projects';const r=await api(url,token,{method:editingProject?'PUT':'POST',body:JSON.stringify(projectForm)});if(r.ok){setMsg('Project saved');setEditingProject(null);setProjectForm({title:'',category:'',description:'',image:'',video:'',featured:false});load()}else setMsg('Could not save project')};const deleteProject=async id=>{if(!confirm('Delete project?'))return;await api(`/api/admin/projects/${id}`,token,{method:'DELETE'});load()};const customerSearch=useMemo(()=>data.customers.filter(c=>{const q=search.toLowerCase().trim();return !q||String(c.id||'').toLowerCase().includes(q)||String(c.name||'').toLowerCase().includes(q)||String(c.phone||'').toLowerCase().includes(q)||String(c.email||'').toLowerCase().includes(q)}),[data.customers,search]);const filteredEnquiries=useMemo(()=>data.enquiries.filter(e=>{const q=search.toLowerCase().trim();return !q||String(e.bookingId||'').toLowerCase().includes(q)||String(e.customerId||'').toLowerCase().includes(q)||String(e.name||'').toLowerCase().includes(q)||String(e.phone||'').toLowerCase().includes(q)||String(e.email||'').toLowerCase().includes(q)}),[data.enquiries,search]);const bookingForCustomer=id=>{const enquiry=data.enquiries.find(e=>e.customerId===id&&e.bookingId);if(enquiry)return enquiry.bookingId;const shoot=data.shoots.find(s=>s.customerId===id&&s.bookingId);return shoot?.bookingId||''};const openCustomer=async id=>{const r=await api(`/api/admin/customers/${id}`,token);if(r.ok)setSelectedCustomer(await r.json())};const openBooking=bookingId=>{const id=String(bookingId||'').trim();const enquiry=data.enquiries.find(e=>String(e.bookingId||'').trim()===id);const shoot=data.shoots.find(s=>String(s.bookingId||'').trim()===id);const customerId=enquiry?.customerId||shoot?.customerId||'';const customer=data.customers.find(c=>String(c.id||'').trim()===String(customerId).trim());const invoices=data.invoices.filter(i=>String(i.bookingId||'').trim()===id);setSelectedBooking({bookingId:id,enquiry,shoot,customer,invoices})};const createInvoiceFor=(customerId,bookingId='')=>{setTab('billing');setInvoiceForm({customerId,bookingId:bookingId||bookingForCustomer(customerId),type:'Advance',items:[{name:'Advance / Booking',amount:''}],total:'',amountDue:'',paid:'0',notes:''});setSelectedCustomer(null)};const updateStatus=async(e,id)=>{await api(`/api/admin/enquiries/${id}`,token,{method:'PUT',body:JSON.stringify({status:e.target.value})}).catch(()=>{});load()};const saveShoot=async e=>{e.preventDefault();const r=await api('/api/admin/shoots',token,{method:'POST',body:JSON.stringify({...shootForm,services:shootForm.services.split(',').map(x=>x.trim()).filter(Boolean)})});if(r.ok){setMsg('Shoot added');setShootForm({customerId:'',bookingId:'',shootDate:'',location:'',type:'Wedding',status:'Upcoming',services:'',notes:''});load()}};const createInvoice=async e=>{e.preventDefault();const items=invoiceForm.items.map(x=>({...x,amount:Number(x.amount||0)}));const total=Number(invoiceForm.total||items.reduce((s,x)=>s+x.amount,0));const due=Number(invoiceForm.amountDue||total);const paid=Number(invoiceForm.paid||0);const r=await api('/api/admin/invoices',token,{method:'POST',body:JSON.stringify({...invoiceForm,items,total,amountDue:due,paid,balance:Math.max(0,due-paid)})});if(r.ok){setMsg('Invoice created');setInvoiceForm({customerId:'',bookingId:'',type:'Advance',items:[{name:'Advance / Booking',amount:''}],total:'',amountDue:'',paid:'0',notes:''});load()}else setMsg('Could not create invoice')};const sendInvoice=async(id,kind)=>{const r=await api(`/api/admin/invoices/${id}/send-${kind}`,token,{method:'POST'});const d=await r.json();setMsg(r.ok?(d.sent?`Invoice sent by ${kind}.`:`${kind==='whatsapp'?'WhatsApp':'Email'} is not configured.`):(d.error||'Delivery failed'))};const saveSettings=async e=>{e.preventDefault();const r=await api('/api/admin/settings',token,{method:'PUT',body:JSON.stringify(settingsForm)});if(r.ok){setMsg('Settings saved');load()}};const dashboard={customers:data.customers.length,enquiries:data.enquiries.length,shoots:data.shoots.length,invoices:data.invoices.length,upcoming:data.shoots.filter(s=>['Upcoming','Confirmed'].includes(s.status)).length,completed:data.shoots.filter(s=>s.status==='Completed').length,paid:data.invoices.reduce((s,i)=>s+Number(i.paid||0),0),balance:data.invoices.reduce((s,i)=>s+Number(i.balance||0),0)};if(!token)return <div className="admin-page"><div className="admin-login"><Logo/><div className="eyebrow">SECURE STUDIO ACCESS</div><h1>BV <em>ADMIN</em></h1><p>Customer CRM, bookings, projects, billing and payments.</p><form onSubmit={doLogin}><input placeholder="Username" value={login.username} onChange={e=>setLogin({...login,username:e.target.value})}/><input type="password" placeholder="Password" value={login.password} onChange={e=>setLogin({...login,password:e.target.value})}/><button className="gold-btn">Enter Studio <ArrowRight size={16}/></button></form>{msg&&<div className="status">{msg}</div>}</div></div>;return <div className="admin-page"><header className="admin-top"><Logo/><div><span className="admin-live"><span/> ADMIN ONLINE</span><button className="ghost-btn" onClick={()=>{localStorage.removeItem('bv_admin_token');setToken('')}}><LogOut size={14}/> Logout</button></div></header><div className="admin-layout"><aside><button className={tab==='dashboard'?'active':''} onClick={()=>setTab('dashboard')}><LayoutDashboard/> Dashboard</button><button className={tab==='customers'?'active':''} onClick={()=>setTab('customers')}><Users/> Customers</button><button className={tab==='enquiries'?'active':''} onClick={()=>setTab('enquiries')}><Mail/> Enquiries <b>{data.enquiries.length}</b></button><button className={tab==='shoots'?'active':''} onClick={()=>setTab('shoots')}><CalendarDays/> Shoots</button><button className={tab==='projects'?'active':''} onClick={()=>setTab('projects')}><Clapperboard/> Projects</button><button className={tab==='billing'?'active':''} onClick={()=>setTab('billing')}><Receipt/> Invoices & Billing</button><button className={tab==='settings'?'active':''} onClick={()=>setTab('settings')}><Settings/> Settings</button><a href="/">>- View Website</a></aside><section className="admin-main">{msg&&<div className="admin-toast">{msg}</div>}{tab==='dashboard'&&<><AdminHeading eyebrow="STUDIO OVERVIEW" title="Command <em>Centre.</em>"/><div className="metric-grid">{[['Customers',dashboard.customers,Users],['Enquiries',dashboard.enquiries,Mail],['Shoots',dashboard.shoots,CalendarDays],['Invoices',dashboard.invoices,Receipt],['Upcoming',dashboard.upcoming,CalendarDays],['Completed',dashboard.completed,Check],['Paid',`â‚¹${dashboard.paid.toLocaleString('en-IN')}`,WalletCards],['Balance',`â‚¹${dashboard.balance.toLocaleString('en-IN')}`,WalletCards]].map(([n,v,I])=><div className="metric" key={n}><I size={18}/><small>{n}</small><strong>{v}</strong></div>)}</div><div className="admin-card"><div className="card-title">Recent enquiries</div>{data.enquiries.slice(0,5).map(e=><div className="row-line" key={e.id}><div><b>{e.bookingId}</b><span>{e.name} â€¢ {e.type}</span></div><span>{e.status}</span></div>)}</div></>}{tab==='customers'&&<><AdminHeading eyebrow="CRM" title="Customer <em>Directory.</em>"/><div className="searchbar"><Search size={17}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search Customer ID, Booking, name or phone..."/></div><div className="customer-grid">{customerSearch.map(c=><button className="customer-card" key={c.id} onClick={()=>openCustomer(c.id)}><span>{c.id}</span><h3>{c.name}</h3><p>{c.phone} â€¢ {c.email}</p><b>Open full history ></b></button>)}</div>{selectedCustomer&&<CustomerModal data={selectedCustomer} onClose={()=>setSelectedCustomer(null)} token={token} onRefresh={load} sendInvoice={sendInvoice} onCreateInvoice={createInvoiceFor}/>}{selectedBooking&&<BookingModal data={selectedBooking} onClose={()=>setSelectedBooking(null)} onOpenCustomer={openCustomer} onCreateInvoice={createInvoiceFor}/>}</>}{tab==='enquiries'&&<><AdminHeading eyebrow="CLIENT PIPELINE" title="Incoming <em>Enquiries.</em>"/><div className="searchbar admin-search"><Search size={17}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search Customer ID, Booking ID, name, phone or email..."/></div><div className="enquiry-list">{filteredEnquiries.map(e=><article key={e.id}><div className="enq-top"><div><span>{e.bookingId} â€¢ {e.customerId}</span><h3>{e.name}</h3></div><select value={e.status||'New Enquiry'} onChange={x=>updateStatus(x,e.id)}><option>New Enquiry</option><option>Contacted</option><option>Confirmed</option><option>Cancelled</option><option>Completed</option></select></div><div className="enq-grid"><p><b>Phone</b>{e.phone}</p><p><b>Email</b>{e.email}</p><p><b>Type</b>{e.type}</p><p><b>Services</b>{(e.customServices||[]).join(', ')}</p></div><p className="enq-details">{e.details}</p><div className="enq-links"><button className="booking-link" onClick={()=>openBooking(e.bookingId)}>Open Booking â€¢ {e.bookingId}</button><a href={`mailto:${e.email}`}><Mail size={14}/> Email client</a><a href={`https://wa.me/${String(e.phone).replace(/\D/g,'')}`} target="_blank" rel="noreferrer"><MessageCircle size={14}/> WhatsApp</a><button onClick={()=>openCustomer(e.customerId)}>Open Customer â€¢ {e.customerId}</button></div></article>)}</div></>}{tab==='shoots'&&<><AdminHeading eyebrow="PRODUCTION CALENDAR" title="Bookings & <em>Shoots.</em>"/><form className="admin-card admin-editor" onSubmit={saveShoot}><div className="form-grid"><label>Customer<select required value={shootForm.customerId} onChange={e=>{const customerId=e.target.value;setShootForm({...shootForm,customerId,bookingId:bookingForCustomer(customerId)})}}><option value="">Select customer</option>{data.customers.map(c=><option key={c.id} value={c.id}>{c.id} â€” {c.name}</option>)}</select></label><label>Booking ID<input value={shootForm.bookingId} readOnly placeholder="Auto-filled from enquiry"/><small className="field-hint">Automatically linked to the selected client.</small></label><label>Shoot date<input type="date" value={shootForm.shootDate} onChange={e=>setShootForm({...shootForm,shootDate:e.target.value})}/></label><label>Status<select value={shootForm.status} onChange={e=>setShootForm({...shootForm,status:e.target.value})}><option>Upcoming</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option></select></label></div><label>Location<input value={shootForm.location} onChange={e=>setShootForm({...shootForm,location:e.target.value})}/></label><label>Services (comma separated)<input value={shootForm.services} onChange={e=>setShootForm({...shootForm,services:e.target.value})}/></label><label>Notes<textarea rows="3" value={shootForm.notes} onChange={e=>setShootForm({...shootForm,notes:e.target.value})}/></label><button className="gold-btn"><Plus size={16}/> Add Shoot</button></form><div className="admin-card table-card">{data.shoots.map(s=><div className="row-line" key={s.id}><div><b>{s.bookingId||'No booking ID'}</b><span>{data.customers.find(c=>c.id===s.customerId)?.name||s.customerId} â€¢ {s.type}</span></div><span>{s.shootDate||'Date not set'} â€¢ {s.status}</span></div>)}</div></>}{tab==='projects'&&<><AdminHeading eyebrow="PORTFOLIO CONTROL" title="Projects <em>Library.</em>"/><div className="two-col"><form className="admin-card admin-editor" onSubmit={saveProject}><label>Project title<input required value={projectForm.title} onChange={e=>setProjectForm({...projectForm,title:e.target.value})}/></label><label>Category<input required value={projectForm.category} onChange={e=>setProjectForm({...projectForm,category:e.target.value})}/></label><label>Cover image URL<input required value={projectForm.image} onChange={e=>setProjectForm({...projectForm,image:e.target.value})}/></label><label>Video / Reel URL<input value={projectForm.video||''} onChange={e=>setProjectForm({...projectForm,video:e.target.value})}/></label><label>Description<textarea rows="4" value={projectForm.description} onChange={e=>setProjectForm({...projectForm,description:e.target.value})}/></label><label className="check-row"><input type="checkbox" checked={!!projectForm.featured} onChange={e=>setProjectForm({...projectForm,featured:e.target.checked})}/> Featured project</label><button className="gold-btn"><Send size={15}/> {editingProject?'Update':'Publish'} Project</button></form><div className="admin-projects">{data.projects.map(p=><div className="admin-project" key={p.id}><img src={p.image} alt=""/><div><span>{p.category}</span><h3>{p.title}</h3><p>{p.description}</p><div className="admin-actions"><button onClick={()=>{setEditingProject(p.id);setProjectForm(p)}}><Edit3 size={14}/> Edit</button><button onClick={()=>deleteProject(p.id)}><Trash2 size={14}/> Delete</button></div></div></div>)}</div></div></>}{tab==='billing'&&<><AdminHeading eyebrow="FINANCE" title="Invoices & <em>Billing.</em>"/><form className="admin-card admin-editor" onSubmit={createInvoice}><div className="form-grid"><label>Customer<select required value={invoiceForm.customerId} onChange={e=>{const customerId=e.target.value;setInvoiceForm({...invoiceForm,customerId,bookingId:bookingForCustomer(customerId)})}}><option value="">Select customer</option>{data.customers.map(c=><option key={c.id} value={c.id}>{c.id} â€” {c.name}</option>)}</select></label><label>Booking ID<input value={invoiceForm.bookingId} readOnly placeholder="Auto-filled from client enquiry"/><small className="field-hint">No manual typing required.</small></label><label>Invoice type<select value={invoiceForm.type} onChange={e=>setInvoiceForm({...invoiceForm,type:e.target.value})}><option>Advance</option><option>Partial Payment</option><option>Final Payment</option><option>Full Payment</option></select></label><label>Total project amount<input type="number" min="0" value={invoiceForm.total} onChange={e=>setInvoiceForm({...invoiceForm,total:e.target.value})} placeholder="50000"/></label><label>Amount due now<input type="number" min="0" value={invoiceForm.amountDue} onChange={e=>setInvoiceForm({...invoiceForm,amountDue:e.target.value})} placeholder="20000"/></label><label>Already paid<input type="number" min="0" value={invoiceForm.paid} onChange={e=>setInvoiceForm({...invoiceForm,paid:e.target.value})}/></label></div><label>Invoice line item<input value={invoiceForm.items[0].name} onChange={e=>setInvoiceForm({...invoiceForm,items:[{...invoiceForm.items[0],name:e.target.value}]})}/></label><label>Line amount<input type="number" min="0" value={invoiceForm.items[0].amount} onChange={e=>setInvoiceForm({...invoiceForm,items:[{...invoiceForm.items[0],amount:e.target.value}]})}/></label><label>Notes<textarea rows="3" value={invoiceForm.notes} onChange={e=>setInvoiceForm({...invoiceForm,notes:e.target.value})}/></label><button className="gold-btn"><Receipt size={16}/> Create Invoice</button></form><div className="invoice-list">{data.invoices.map(i=>{const c=data.customers.find(x=>x.id===i.customerId);return <article className="invoice-card" key={i.id}><div><span>{i.invoiceNo}</span><h3>{c?.name||i.customerId}</h3><p>{i.type} â€¢ Booking {i.bookingId||'â€”'}</p></div><div className="invoice-numbers"><b>Due â‚¹{Number(i.amountDue||0).toLocaleString('en-IN')}</b><span>Paid â‚¹{Number(i.paid||0).toLocaleString('en-IN')} â€¢ Balance â‚¹{Number(i.balance||0).toLocaleString('en-IN')}</span></div><div className="admin-actions"><a href={`/api/admin/documents/invoice/${i.id}`} onClick={e=>{e.preventDefault();fetch(`/api/admin/documents/invoice/${i.id}`,{headers:headers()}).then(r=>r.blob()).then(b=>{const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=`${i.invoiceNo}.pdf`;a.click();URL.revokeObjectURL(u)})}}><Download size={14}/> PDF</a><button onClick={()=>sendInvoice(i.id,'email')}><Mail size={14}/> Email PDF</button><button onClick={()=>sendInvoice(i.id,'whatsapp')}><MessageCircle size={14}/> WhatsApp PDF</button></div></article>})}</div></>}{tab==='settings'&&<><AdminHeading eyebrow="BUSINESS SETTINGS" title="Studio <em>Settings.</em>"/><form className="admin-card admin-editor" onSubmit={saveSettings}><label>Business name<input value={settingsForm.businessName||''} onChange={e=>setSettingsForm({...settingsForm,businessName:e.target.value})}/></label><label>Business phone<input value={settingsForm.phone||''} onChange={e=>setSettingsForm({...settingsForm,phone:e.target.value})}/></label><label>Business email<input type="email" value={settingsForm.email||''} onChange={e=>setSettingsForm({...settingsForm,email:e.target.value})}/></label><label>UPI ID<input value={settingsForm.upiId||''} onChange={e=>setSettingsForm({...settingsForm,upiId:e.target.value})} placeholder="yourname@upi"/></label><label>UPI display name<input value={settingsForm.upiName||''} onChange={e=>setSettingsForm({...settingsForm,upiName:e.target.value})}/></label><div className="locked-box"><WalletCards size={18}/><div><b>Invoice QR</b><span>Once a UPI ID is saved, every new invoice PDF automatically contains a scannable UPI QR for the amount due.</span></div></div><button className="gold-btn"><Settings size={16}/> Save Settings</button></form></>}</section></div></div>}
function AdminHeading({eyebrow,title}){return <div className="admin-heading"><div><div className="eyebrow">{eyebrow}</div><h2 dangerouslySetInnerHTML={{__html:title}}/></div></div>}

function BookingModal({data,onClose,onOpenCustomer,onCreateInvoice}){const{bookingId,enquiry,shoot,customer,invoices}=data;return <div className="modal-backdrop" onClick={onClose}><div className="customer-modal booking-modal" onClick={e=>e.stopPropagation()}><button className="modal-close" onClick={onClose}><X/></button><div className="eyebrow">BOOKING DETAILS / CRM</div><h2>{bookingId}</h2>{customer&&<div className="customer-id-large">{customer.id} â€¢ {customer.name}</div>}<div className="profile-grid">{customer&&<div><b>CLIENT</b><span>{customer.name}</span></div>}<div><b>PROJECT</b><span>{enquiry?.type||shoot?.type||'â€”'}</span></div><div><b>STATUS</b><span>{enquiry?.status||shoot?.status||'â€”'}</span></div><div><b>DATE</b><span>{shoot?.shootDate||'Not scheduled'}</span></div><div><b>LOCATION</b><span>{shoot?.location||'Not set'}</span></div><div><b>EMAIL</b><span>{customer?.email||enquiry?.email||'â€”'}</span></div></div>{enquiry&&<div className="history-block"><h3>Enquiry</h3><p>{enquiry.details}</p><p><b>Services:</b> {(enquiry.customServices||[]).join(', ')||'â€”'}</p></div>}{invoices.length>0&&<div className="history-block"><h3>Invoices</h3>{invoices.map(i=><div className="history-row" key={i.id}><b>{i.invoiceNo}</b><span>{i.type}</span><span>â‚¹{Number(i.amountDue||0).toLocaleString('en-IN')}</span><em>{i.status}</em></div>)}</div>}<div className="profile-actions">{customer&&<button className="ghost-btn" onClick={()=>{onClose();onOpenCustomer(customer.id)}}>Open Customer</button>}{customer&&<button className="gold-btn" onClick={()=>onCreateInvoice(customer.id,bookingId)}><Receipt size={15}/> Create Invoice</button>}</div></div></div>}
function CustomerModal({data,onClose,onCreateInvoice}){const c=data.customer;return <div className="modal-backdrop" onClick={onClose}><div className="customer-modal" onClick={e=>e.stopPropagation()}><button className="modal-close" onClick={onClose}><X/></button><div className="eyebrow">CLIENT DETAILS / CRM PROFILE</div><h2>{c.name}</h2><div className="customer-id-large">{c.id}</div><p className="customer-id-help">Permanent Customer ID â€¢ Use this ID to find this client for every future enquiry, shoot and invoice.</p><div className="profile-grid"><div><b>PHONE</b><span>{c.phone}</span></div><div><b>EMAIL</b><span>{c.email}</span></div></div><div className="profile-actions"><button className="gold-btn" onClick={()=>onCreateInvoice(c.id,data.enquiries?.[0]?.bookingId||data.shoots?.[0]?.bookingId||'')}><Receipt size={15}/> Create Invoice for Client</button></div><div className="history-block"><h3>Current / all shoots</h3>{data.shoots.length?data.shoots.map(s=><div className="history-row" key={s.id}><button className="history-booking" onClick={()=>onCreateInvoice(c.id,s.bookingId||'')}>{s.bookingId||'â€”'}</button><span>{s.type}</span><span>{s.shootDate||'â€”'}</span><em>{s.status}</em></div>):<p>No shoots yet.</p>}</div><div className="history-block"><h3>Previous & upcoming</h3>{data.shoots.filter(s=>s.status==='Completed').map(s=><div className="history-row" key={'p'+s.id}><b>Previous</b><span>{s.type}</span><span>{s.shootDate||'â€”'}</span><em>Completed</em></div>)}{data.shoots.filter(s=>s.status!=='Completed'&&s.status!=='Cancelled').map(s=><div className="history-row" key={'u'+s.id}><b>Upcoming</b><span>{s.type}</span><span>{s.shootDate||'â€”'}</span><em>{s.status}</em></div>)}</div><div className="history-block"><h3>Invoices & payments</h3>{data.invoices.length?data.invoices.map(i=><div className="history-row" key={i.id}><b>{i.invoiceNo}</b><span>{i.type}</span><span>â‚¹{Number(i.amountDue||0).toLocaleString('en-IN')}</span><em>{i.status}</em></div>):<p>No invoices yet.</p>}</div><div className="history-block"><h3>Enquiry history</h3>{data.enquiries.map(e=><div className="history-row" key={e.id}><button className="history-booking" onClick={()=>onCreateInvoice(c.id,e.bookingId)}>{e.bookingId}</button><span>{e.type}</span><span>{new Date(e.createdAt).toLocaleDateString('en-IN')}</span><em>{e.status}</em></div>)}</div></div></div>
}
createRoot(document.getElementById('root')).render(
  location.pathname.startsWith('/admin') ? <Admin /> : <App />
);


